// HeroTitle.tsx - Dynamic Phrase Cycling
const [phraseIndex, setPhraseIndex] = useState(0);
const [isTransitioning, setIsTransitioning] = useState(false);

useEffect(() => {
    const interval = setInterval(() => {
        setIsTransitioning(true);
        setTimeout(() => {
            setPhraseIndex((prev) => (prev + 1) % PHRASES.length);
            setIsTransitioning(false);
        }, 500); 
    }, 4000); 
    return () => clearInterval(interval);
}, []);
```
<!-- slide -->
```tsx
// AnimatedBackground.tsx - Scroll Parallax
useEffect(() => {
    const handleScroll = () => {
        if (!containerRef.current) return;
        const scrollY = window.scrollY;
        containerRef.current.style.setProperty('--scroll-y', `${scrollY}px`);
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    return () => window.removeEventListener('scroll', handleScroll);
}, []);
```
<!-- slide -->
```css
/* AnimatedBackground.module.css - Parallax CSS */
.parallaxWrapper {
    position: absolute;
    inset: 0;
    will-change: transform;
    transform: translateY(calc(var(--scroll-y, 0px) * var(--parallax-speed, 0)));
}
```
